{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatList",
  "version": "0.2.0",
  "identifier": "com.floatlist.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FloatList",
        "width": 320,
        "height": 420,
        "minWidth": 260,
        "minHeight": 160,
        "maxWidth": 520,
        "maxHeight": 760,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "center": false,
        "focus": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Productivity",
    "shortDescription": "始终悬浮在桌面上的极简工作清单",
    "longDescription": "FloatList 是一款本地优先、透明、轻量的 macOS 桌面悬浮工作清单。",
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
