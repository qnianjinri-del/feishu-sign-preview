# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://sign.example.com
DEFAULT_JUMP_URL=https://sign.example.com/
DEFAULT_HELP_PATH=/

# Feishu application credentials (required for preview and synchronization)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Link-preview callback verification (optional when that capability is unused)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Bitable target (app token and table ID are required for synchronization)
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
BITABLE_VIEW_ID=

# Bitable field mapping
BITABLE_RESULT_FIELD_NAME=任务名
BITABLE_STATUS_FIELD_NAME=任务状态
BITABLE_SUBTASK_STATUS_FIELD_NAME=子状态
BITABLE_CHILD_STATUS_FIELD_NAME=FloatList子事项状态
BITABLE_SUBTASK_DATA_FIELD_NAME=FloatList子事项数据
BITABLE_SYNC_ID_FIELD_NAME=FloatList同步ID
BITABLE_ORDER_FIELD_NAME=FloatList顺序
BITABLE_ARCHIVED_FIELD_NAME=FloatList归档
BITABLE_PARENT_ID_FIELD_NAME=FloatList父事项ID
BITABLE_BLOCKED_REASON_FIELD_NAME=FloatList受阻原因
BITABLE_DUE_DATE_FIELD_NAME=日期
BITABLE_DUE_TIME_FIELD_NAME=FloatList截止时刻
BITABLE_PRIORITY_FIELD_NAME=优先级
BITABLE_REMINDER_AT_FIELD_NAME=FloatList提醒时间
BITABLE_TARGET_STATUS=在干
FLOATLIST_TIME_ZONE=Asia/Shanghai

# Feishu request and preview limits
BITABLE_CACHE_TTL_SECONDS=60
BITABLE_REQUEST_TIMEOUT_MS=1500
MAX_TEXT_LENGTH=80
ENABLE_CARD_PREVIEW=false
HANDLER_TIMEOUT_MS=1500
DEBUG_TIMEOUT_MS=2000

# Desktop sync API. Generate a dedicated random value of at least 32 characters.
FLOATLIST_CLIENT_TOKEN=
FLOATLIST_SYNC_BODY_LIMIT=131072
FLOATLIST_IDEMPOTENCY_TTL_SECONDS=3600
FLOATLIST_RATE_LIMIT_WINDOW_SECONDS=60
FLOATLIST_RATE_LIMIT_MAX_REQUESTS=120
